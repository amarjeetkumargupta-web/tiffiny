# Environment Variables Template for Tiffiny
# Copy this file to .env and fill in real values for your environment.

# Active Environment: 'dev' or 'prod'
APP_ENV=dev

# Firebase Configuration (Generated from Firebase Console)
FIREBASE_API_KEY=AIzaSyPlaceholderKeyForClientApp
FIREBASE_APP_ID=1:1234567890:android:abcdef123456
FIREBASE_MESSAGING_SENDER_ID=1234567890
FIREBASE_PROJECT_ID=tiffiny-app-prod
FIREBASE_STORAGE_BUCKET=tiffiny-app-prod.appspot.com

# Google Maps SDK API Keys
GOOGLE_MAPS_API_KEY_ANDROID=AIzaSyPlaceholderGoogleMapsKeyAndroid
GOOGLE_MAPS_API_KEY_IOS=AIzaSyPlaceholderGoogleMapsKeyIOS

# Razorpay Payment Gateway (Test or Live Key ID)
# Secret key is NEVER stored here or in the mobile client; only in Cloud Functions Secret Manager!
RAZORPAY_KEY_ID=rzp_test_placeholderKey12345678

# Cloud Functions Base URL (optional override for local Firebase emulator)
# FUNCTIONS_BASE_URL=http://10.0.2.2:5001/tiffiny-app-prod/us-central1
